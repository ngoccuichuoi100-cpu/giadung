                                        @php
                                            $rewards = $luckyWheelGame->rewards()->where('status', 'active')->get();
                                            $slicesCount = $rewards->count();
                                        @endphp
                                        @foreach($rewards as $index => $reward)
                                            @php
                                                $angleStep = 360 / ($slicesCount ?: 1);
                                                $angle = $index * $angleStep;
                                                // Calculate SVG coordinates for slices
                                                $radStart = deg2rad($angle - 90);
                                                $radEnd = deg2rad($angle + $angleStep - 90);
                                                $x1 = 50 + 50 * cos($radStart);
                                                $y1 = 50 + 50 * sin($radStart);
                                                $x2 = 50 + 50 * cos($radEnd);
                                                $y2 = 50 + 50 * sin($radEnd);
                                                
                                                // Alt colors
                                                $colors = ['#F97316', '#F59E0B', '#10B981', '#3B82F6', '#6366F1', '#EC4899', '#8B5CF6', '#14B8A6'];
                                                $sliceColor = $colors[$index % count($colors)];
                                            @endphp
                                            <path d="M50,50 L{{ $x1 }},{{ $y1 }} A50,50 0 0,1 {{ $x2 }},{{ $y2 }} Z" fill="{{ $sliceColor }}" opacity="0.85"></path>
                                            
                                            <!-- Texts placed inside slices -->
                                            @php
                                                $textAngle = $angle + ($angleStep / 2) - 90;
                                                $textRad = deg2rad($textAngle);
                                                $tx = 50 + 32 * cos($textRad);
                                                $ty = 50 + 32 * sin($textRad);
                                            @endphp
                                            <text x="{{ $tx }}" y="{{ $ty }}" fill="#white" font-size="3" font-weight="bold" text-anchor="middle" transform="rotate({{ $textAngle + 90 }} {{ $tx }} {{ $ty }})" class="fill-white font-black text-[3.5px]">
                                                {{ $reward->name }}
                                            </text>
                                        @endforeach
                                    </svg>
                                    
