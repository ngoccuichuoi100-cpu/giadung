    <!-- Spin script logic -->
    <script>
        let isSpinning = false;

        function spinWheel() {
            if (isSpinning) return;

            const spinBtn = document.getElementById('spin-btn');
            const attemptsCountEl = document.getElementById('wheel-attempts-count');
            const userPointsEl = document.getElementById('user-points-display');
            const wheel = document.getElementById('wheel');

            isSpinning = true;
            spinBtn.disabled = true;

            fetch('{{ route("games.spin") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': '{{ csrf_token() }}'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    alert(data.message);
                    isSpinning = false;
                    spinBtn.disabled = false;
                    return;
                }

                // rotation animation: spin at least 5 full rotations (1800 deg) + angle
                const currentRotation = parseInt(wheel.style.transform.replace(/[^0-9]/g, '')) || 0;
                const newRotation = currentRotation + 1800 + data.angle;

                wheel.style.transform = `rotate(${newRotation}deg)`;

                // Wait for spin transition (4 seconds)
                setTimeout(() => {
                    alert(`Chúc mừng! ${data.reward_name}. \n${data.reward_msg}`);
                    
                    // Update display values
                    if (userPointsEl) userPointsEl.innerText = data.user_points.toLocaleString('vi-VN') + ' điểm';
                    if (attemptsCountEl) {
                        const count = parseInt(attemptsCountEl.innerText) || 0;
                        attemptsCountEl.innerText = count + 1;
                    }
                    spinBtn.innerText = 'Quay Thưởng (20 điểm)';

                    isSpinning = false;
                    spinBtn.disabled = false;
                }, 4100);
            })
            .catch(err => {
                console.error(err);
                isSpinning = false;
                spinBtn.disabled = false;
            });
        }
    </script>
@endsection
